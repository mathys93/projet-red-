package main

import (
	"fmt"
	"time"
)

type Character struct {
	Name      string
	HpMax     int
	HpCurrent int
	Inventory []string
}

// 1. Fonction poisonPot
func (c *Character) poisonPot() {
	fmt.Println("--- Effet de la potion de poison ---")
	for i := 1; i <= 3; i++ {
		time.Sleep(1 * time.Second)
		c.HpCurrent -= 10

		if c.HpCurrent < 0 {
			c.HpCurrent = 0
		}

		fmt.Printf("Seconde %d : PV %d / %d\n", i, c.HpCurrent, c.HpMax)
	}
}

// 2. Intégration chez le marchand
func (c *Character) buyFromMerchant(item string) {
	if item == "Potion de poison" {
		c.Inventory = append(c.Inventory, "Potion de poison")
		fmt.Println("Vous avez acheté une Potion de poison et l'avez ajoutée à votre inventaire.")
	}
}

// 3. Gestion de l'inventaire et utilisation des objets
func (c *Character) accessInventory() {
	if len(c.Inventory) == 0 {
		fmt.Println("Votre inventaire est vide.")
		return
	}

	fmt.Println("\n--- Inventaire ---")
	for i, item := range c.Inventory {
		fmt.Printf("%d. %s\n", i+1, item)
	}

	var choice int
	fmt.Print("Choisissez le numéro de l'objet à utiliser (0 pour quitter) : ")
	fmt.Scanln(&choice)

	if choice > 0 && choice <= len(c.Inventory) {
		itemUsed := c.Inventory[choice-1]

		// Retire l'objet utilisé de l'inventaire
		c.Inventory = append(c.Inventory[:choice-1], c.Inventory[choice:]...)

		// Déclenche l'effet correspondant à l'objet
		switch itemUsed {
		case "Potion de poison":
			c.poisonPot()
		default:
			fmt.Printf("Vous utilisez %s.\n", itemUsed)
		}
	} else if choice == 0 {
		fmt.Println("Vous fermez l'inventaire.")
	} else {
		fmt.Println("Choix invalide.")
	}
}

func main() {
	player := Character{
		Name:      "Aventurier",
		HpMax:     100,
		HpCurrent: 100,
		Inventory: []string{},
	}

	// Exemple : Achat auprès du marchand
	player.buyFromMerchant("Potion de poison")

	// Exemple : Ouverture de l'inventaire et utilisation de l'objet
	player.accessInventory()
}
